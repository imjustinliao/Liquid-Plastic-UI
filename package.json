{
  "name": "liquid-plastic-ui",
  "version": "0.0.0",
  "description": "Tactile, accessible React controls with a liquid-plastic material system.",
  "keywords": [
    "react",
    "components",
    "ui",
    "segmented-control",
    "liquid-glass",
    "accessible"
  ],
  "license": "MIT",
  "author": "Justin Liao",
  "homepage": "https://github.com/imjustinliao/Liquid-Plastic-UI#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imjustinliao/Liquid-Plastic-UI.git"
  },
  "bugs": {
    "url": "https://github.com/imjustinliao/Liquid-Plastic-UI/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsup",
    "build:demo": "vite build --outDir site",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "test:package": "npm pack --dry-run",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "happy-dom": "^20.14.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
